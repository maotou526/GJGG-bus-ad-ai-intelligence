## 序列化器开发规范

### 序列化器分类

按使用场景定义不同的序列化器：

```python
'''
Description: 模型序列化器
Version: 1.0
Author: 开发者姓名
Date: YYYY-MM-DD
LastEditors: 
LastEditTime: YYYY-MM-DD
'''
from rest_framework import serializers
from dvadmin.utils.serializers import CustomModelSerializer
from .models import YourModel

class YourModelSerializer(CustomModelSerializer):
    """
    基础序列化器
    用于详情、更新等场景
    """
    
    # 计算字段
    type_display = serializers.SerializerMethodField()
    
    class Meta:
        model = YourModel
        fields = "__all__"
        read_only_fields = ["id", "create_datetime", "update_datetime"]
    
    def get_type_display(self, obj):
        """获取显示字段"""
        return obj.type if obj else "未知"


class YourModelCreateSerializer(YourModelSerializer):
    """
    创建序列化器
    用于创建新记录时的验证
    """
    
    class Meta(YourModelSerializer.Meta):
        extra_kwargs = {
            "name": {"required": True},
            "type": {"required": True},
        }


class YourModelUpdateSerializer(YourModelSerializer):
    """
    更新序列化器
    用于更新现有记录时的验证
    """
    
    class Meta(YourModelSerializer.Meta):
        read_only_fields = ["id", "create_datetime", "update_datetime"]
    
    def validate(self, attrs):
        """整体验证"""
        attrs = super().validate(attrs)
        # 自定义验证逻辑
        return attrs


class YourModelListSerializer(YourModelSerializer):
    """
    列表序列化器
    只包含列表展示需要的核心字段
    """
    
    class Meta:
        model = YourModel
        fields = [
            "id",
            "name",
            "type",
            "type_display",
            "create_datetime",
            "update_datetime",
        ]
        read_only_fields = fields
```

### 验证方法规范

```python
class YourModelSerializer(CustomModelSerializer):
    """序列化器"""
    
    def validate_name(self, value):
        """字段级验证"""
        if not value or not value.strip():
            raise serializers.ValidationError("名称不能为空")
        return value.strip()
    
    def validate(self, attrs):
        """对象级验证"""
        # 调用父类验证
        attrs = super().validate(attrs)
        
        # 自定义验证逻辑
        parent_id = attrs.get('parent_id')
        current_type = attrs.get('type')
        
        if parent_id and current_type:
            # 验证层级关系
            parent = YourModel.objects.filter(id=parent_id).first()
            if parent:
                # 层级验证逻辑
                pass
        
        return attrs
```

